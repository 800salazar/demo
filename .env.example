# Copia este archivo a .env.local para desarrollo local. Nunca subas valores reales al repositorio.
# En Vercel se configuran en Project Settings → Environment Variables.

# --- Inteligencia artificial (solo servidor) ---
# Autenticación: AI_GATEWAY_API_KEY o VERCEL_OIDC_TOKEN (automático en Vercel).
AI_GATEWAY_API_KEY=
# Modelo gratuito para pruebas con datos ficticios. Puedes cambiarlo sin tocar código.
AI_MODEL=nvidia/nemotron-3.5-lightning-free
# Sin autenticación/modelo/cuota persistente solo se muestran cálculos, identificados como tales.

# --- Supabase (solo servidor; las órdenes persisten en el navegador) ---
# Enfoca (privado) y Salazar Demo (público) usan el MISMO proyecto Supabase.
# Referencia compartida: acwlzsofiqdaxmwpyczu. Ver docs/architecture.md.
# Project Settings → API Keys en el panel de Supabase. La publishable key es pública por diseño.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: clave secret del proyecto COMPARTIDO, nunca NEXT_PUBLIC_ ni enviada al modelo.
# El código de IA la usa solo para consume_demo_ai_quota; no consulta tablas de Enfoca.
# Requiere verificar la RPC y sus permisos; que demo_ai_usage exista no confirma la función.
SUPABASE_SECRET_KEY=

# --- Contacto comercial ---
# Número de WhatsApp en formato internacional, solo dígitos (por ejemplo 521XXXXXXXXXX).
# Si queda vacío, WhatsApp abre el mensaje y permite elegir el contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=
