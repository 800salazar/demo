# Copia este archivo a .env.local para desarrollo local. Nunca subas valores reales al repositorio.
# En Vercel se configuran en Project Settings → Environment Variables.

# --- Inteligencia artificial (solo servidor) ---
# Sin estas dos variables el asistente de IA aparece como "no disponible"; nunca se simulan respuestas.
OPENAI_API_KEY=
# Modelo a utilizar, por ejemplo uno económico de tu cuenta de OpenAI.
OPENAI_MODEL=

# --- Supabase (preparado; la demo aún persiste en el navegador) ---
# Project Settings → API Keys en el panel de Supabase. La publishable key es pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Contacto comercial ---
# Número de WhatsApp en formato internacional, solo dígitos (por ejemplo 521XXXXXXXXXX).
# Si queda vacío, WhatsApp abre el mensaje y permite elegir el contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=
